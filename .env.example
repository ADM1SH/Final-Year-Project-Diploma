# Copy this file to `.env` (same directory as manage.py) and fill in real
# values. `.env` is already gitignored — never commit it.
#
# core/settings.py calls load_dotenv() at import time, so anything set here
# is available via os.environ.get(...) exactly like a real environment
# variable. Real env vars injected by your host in production always take
# priority over this file.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev,.ngrok-free.app,.ngrok.io

# --- CORS (mobile dev client origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Stripe (get test-mode keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8000/api/transactions/stripe-webhook/`
# when testing the webhook locally; leave as whsec_dummy if you're relying on
# the confirm-payment client fallback instead (see handoff.md).
STRIPE_WEBHOOK_SECRET=whsec_dummy
